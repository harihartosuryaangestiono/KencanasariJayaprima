PORT=5001
NODE_ENV=production

# Gunakan DATABASE_URL dari Supabase (Project Settings > Database > Connection String > URI)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# Untuk development lokal (tidak perlu jika sudah pakai DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=password123
# DB_NAME=plywood_production

JWT_SECRET=ganti-dengan-random-string-minimal-32-karakter

# URL frontend Vercel, contoh: https://kencana.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app
